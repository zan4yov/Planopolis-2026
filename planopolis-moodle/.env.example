# Copy to .env and change every value marked CHANGE.

# Public address participants will open (no trailing slash).
MOODLE_URL=http://localhost:8080
# Set both to true when HTTPS is terminated by Nginx / Cloudflare / a load balancer in front of this container.
MOODLE_SSLPROXY=false
MOODLE_REVERSEPROXY=false
HTTP_PORT=8080

# Database
DB_NAME=moodle
DB_USER=moodle
DB_PASS=CHANGE-a-long-random-password

# Super Admin account created at first start (username + password to log in).
ADMIN_USER=superadmin
ADMIN_PASS=CHANGE-Strong#Password1
ADMIN_EMAIL=panitia@example.com

# Site
SITE_FULLNAME=Planopolis PWK 2026
SITE_SHORTNAME=Planopolis
# id = Bahasa Indonesia (downloaded at first start), en = English
SITE_LANG=id
# Time limit of the first quiz, in minutes (can be changed later in the quiz settings)
QUIZ_TIMELIMIT=150
