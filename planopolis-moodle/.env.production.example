# Production configuration. deploy.sh copies this to .env and fills in the
# addresses and passwords, so you normally do not edit this file by hand.

# ---- How the site is reached -------------------------------------------------
# Leave SITE_ADDRESS empty for plain HTTP on the server's IP.
# Put a hostname here (DNS pointing at this server) to get automatic HTTPS.
SITE_ADDRESS=
# The exact address participants type. Must match SITE_ADDRESS when that is set.
MOODLE_URL=http://localhost
# The address Caddy listens on. Always concrete, never empty:
#   :80              plain HTTP on the server's IP
#   quiz.example.com a hostname, which switches on automatic HTTPS
CADDY_ADDRESS=:80
# true when Caddy terminates HTTPS in front of Moodle (set with a hostname).
MOODLE_SSLPROXY=false
# Keep this false. It makes Moodle refuse any request whose Host header differs
# from MOODLE_URL ("Reverse proxy is enabled, the server cannot be accessed
# directly"), and Caddy passes the host through unchanged.
MOODLE_REVERSEPROXY=false
# Loopback only: the Caddy proxy reaches Moodle over the internal Docker network,
# so this port must never be exposed to the internet.
HTTP_PORT=127.0.0.1:8080

# ---- Database ----------------------------------------------------------------
DB_NAME=moodle
DB_USER=moodle
DB_PASS=GENERATED-BY-DEPLOY-SCRIPT

# ---- Super Admin created at first start --------------------------------------
ADMIN_USER=superadmin
ADMIN_PASS=GENERATED-BY-DEPLOY-SCRIPT
# Used for Let's Encrypt expiry notices and as the site contact.
ADMIN_EMAIL=panitia@example.com

# ---- Site --------------------------------------------------------------------
SITE_FULLNAME=Planopolis PWK 2026
SITE_SHORTNAME=Planopolis
SITE_LANG=id
QUIZ_TIMELIMIT=150
