# Front-end proxy for the Planopolis quiz platform.
#
# CADDY_ADDRESS is always a concrete listen address, never empty:
#   :80                  plain HTTP (access by IP address)
#   quiz.example.com     automatic HTTPS, certificate renewed by Caddy
# deploy.sh writes it into .env. Do not give it a default here: Caddy applies
# {$VAR:default} only when the variable is UNSET, so a set-but-empty value
# would silently produce a site block with no address, which Caddy rejects.
{
	email {$ACME_EMAIL:panitia@example.com}
}

{$CADDY_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# No explicit timeout: Caddy's default is to wait indefinitely, which is what
	# a slow quiz page under load needs. Access logs go to stdout, where Docker's
	# json-file driver rotates them (see docker-compose.prod.yml).
	reverse_proxy moodle:80 {
		# Moodle uses the real client IP for its logs and account lockout.
		header_up X-Real-IP {remote_host}
	}
}
